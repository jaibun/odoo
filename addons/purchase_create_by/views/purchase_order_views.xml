<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_created_by" model="ir.ui.view">
        <field name="name">purchase.order.form.created.by</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="create_by" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_list_created_by" model="ir.ui.view">
        <field name="name">purchase.order.list.created.by</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="create_by" string="Created By" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_rfq_list_created_by" model="ir.ui.view">
        <field name="name">purchase.rfq.list.created.by</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="create_by" string="Created By" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_rfq_kpis_list_created_by" model="ir.ui.view">
        <field name="name">purchase.rfq.kpis.list.created.by</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="create_by" string="Created By" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
